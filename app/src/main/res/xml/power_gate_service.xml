<?xml version="1.0" encoding="utf-8"?>
<!--
  What our accessibility service asks Android for.

  typeWindowStateChanged : a new window / dialog appeared (the power menu fires this)
  typeWindowsChanged     : the window list changed (arrives ~75 ms earlier: our fastest signal)
  flagRetrieveInteractiveWindows : list on-screen windows, so we can find SYSTEM windows
  flagReportViewIds      : view IDs like "com.android.systemui:id/sec_global_actions_item_list"
  flagIncludeNotImportantViews : don't hide layout containers (the power menu's root often is one)
  canRetrieveWindowContent : read SYSTEM windows' labels ("Power off" + "Restart"), the
                           universal detector's language-independent signal

  The detector only ever looks at focused TYPE_SYSTEM windows (SystemUI); app windows
  are skipped before anything is read.

  Note (2026-11-05): a minimal-access version (SystemUI events only, no content
  access) was tried. Paytm STILL refused payments: it blocks any third-party
  accessibility service. So minimal access bought nothing and cost the
  universal label detection. The answer to banking apps is the PIN-protected
  "Pause for payments" (pause/PauseController), not less access.

  isAccessibilityTool=false: we are honest that this is not a screen reader etc.
  (Under Android 17 Advanced Protection the service is blocked; see PLAN.md 2.2.)
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:description="@string/gate_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0" />
