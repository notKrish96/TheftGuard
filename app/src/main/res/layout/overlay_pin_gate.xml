<?xml version="1.0" encoding="utf-8"?>
<!--
  The PIN screen drawn over the power menu / lock screen.
  Deliberately says nothing about force-restart: this is the screen a thief
  sees, so it shouldn't teach them the hardware bypass. That warning lives
  in the app's own main screen instead.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2000000">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 TheftGuard"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/gateMessage"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Enter your TheftGuard PIN to power off or restart"
            android:textColor="#DDDDDD"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/gateDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.4"
            android:minHeight="40dp"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/gateStatus"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="24dp"
            android:textColor="#FF6B6B"
            android:textSize="14sp" />

        <!-- Buttons are added in code (PinGateOverlay.buildKeypad) -->
        <GridLayout
            android:id="@+id/gateKeypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3" />

        <Button
            android:id="@+id/gateCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cancel" />
    </LinearLayout>
</FrameLayout>
