# Copy this file to "keystore.properties" (same folder) and fill in your values.
# keystore.properties is git-ignored: it must NEVER be committed.
# Use forward slashes in the path.
storeFile=K:/Keys/theftguard-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=theftguard
keyPassword=YOUR_KEYSTORE_PASSWORD
